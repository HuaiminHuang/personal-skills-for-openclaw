# === video-tutor 统一配置文件 ===
# 所有脚本通过: source "$SKILL_DIR/config.env" 加载

# === 基础路径 ===
SKILL_NAME="video-tutor"
SKILL_DIR="/home/h2mzzz/.openclaw/skills/${SKILL_NAME}"
VENV_DIR="/home/h2mzzz/.openclaw/venvs/${SKILL_NAME}"

# === Python 环境 ===
VENV_PYTHON="${VENV_DIR}/bin/python"
VENV_PIP="${VENV_DIR}/bin/pip"

# === 数据目录 ===
CACHE_DIR="/home/h2mzzz/.openclaw/openclaw-data/${SKILL_NAME}"
ANALYSES_DIR="${CACHE_DIR}/analyses"

# === 转写配置 ===
WHISPER_LANGUAGE="zh"
AUDIO_SAMPLE_RATE="16000"
WHISPER_MODEL="medium"                              # 可选: tiny, small, medium, large
WHISPER_MODEL_PATH=""                              # 本地模型路径，不填则自动下载

# === 本地 Whisper 模型路径 ===
WHISPER_MODEL_DIR="$HOME/.cache/huggingface/hub/models--Systran--faster-whisper-${WHISPER_MODEL}"

# === 缓存管理 ===
MAX_CACHE_SIZE_GB=10
MAX_CACHE_AGE_DAYS=7

# === FFmpeg 配置 ===
FFMPEG_BIN="ffmpeg"
FFPROBE_BIN="ffprobe"

# === CUDA 配置 ===
CUDA_LIB_PATH="/usr/local/lib/ollama/cuda_v12"
export LD_LIBRARY_PATH="$CUDA_LIB_PATH:$LD_LIBRARY_PATH"
